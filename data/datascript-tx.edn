 #:association-rule{:id "medef.ct-l2151-1-criteres-representativite"
                     :title "Code du travail art. L2151-1: la représentativité des organisations professionnelles d'employeurs est déterminée d'après les critères cumulatifs suivants: 1° le respect des valeurs républicaines; 2° l'indépendance; 3° la transparence financière; 4° une ancienneté minimale de deux ans; puis l'influence et l'audience"
                     :association "medef"
                     :isic "9411"
                     :country "FRA"
                     :kind :statute
                     :url "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000033023411"
                     :url-provenance :official-legifrance
                     :last-revised-date "2016-08-08"
                     :retrieved-at "2026-09-06"
                     :topic [:governance :statute]}
 #:association-rule{:id "medef.ct-l2152-1-branche"
                     :title "Code du travail art. L2152-1: dans les branches professionnelles, sont représentatives les organisations professionnelles d'employeurs qui satisfont aux critères de l'article L. 2151-1, disposent d'une implantation territoriale équilibrée au sein de la branche et dont les entreprises adhérentes représentent au moins 8 % des entreprises adhérant aux organisations candidates"
                     :association "medef"
                     :isic "9411"
                     :country "FRA"
                     :kind :statute
                     :url "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000029946324/2014-12-22"
                     :url-provenance :official-legifrance
                     :last-revised-date "2014-12-20"
                     :retrieved-at "2026-09-06"
                     :topic [:statute]}
 #:association-rule{:id "medef.ct-l2152-4-national-interprofessionnel"
                     :title "Code du travail art. L2152-4: sont représentatives au niveau national et interprofessionnel les organisations professionnelles d'employeurs qui satisfont aux critères des 1° à 5° de l'article L. 2151-1, dont les organisations adhérentes sont représentatives à la fois dans des branches de l'industrie, de la construction, du commerce et des services, et dont les entreprises et organisations adhérentes représentent au moins 8 % de l'ensemble ou au moins 8 % des salariés"
                     :association "medef"
                     :isic "9411"
                     :country "FRA"
                     :kind :statute
                     :url "https://www.legifrance.gouv.fr/codes/section_lc/LEGITEXT000006072050/LEGISCTA000028689659/"
                     :url-provenance :official-legifrance
                     :retrieved-at "2026-09-06"
                     :topic [:governance :statute]}
