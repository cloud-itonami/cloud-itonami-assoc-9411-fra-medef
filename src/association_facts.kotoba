(defn topic-count [a :string i :i64] :i64
  (if (valid-entry? a i)
    (cond
      (= i 0) 1
      (= i 1) 1
      (= i 2) 2
      (= i 3) 1
      (= i 4) 2
      (= i 5) 1
      (= i 6) 2
      (= i 7) 2
      (= i 8) 1
      (= i 9) 2
      (= i 10) 2
      (= i 11) 2
      (= i 12) 2
      :else 0)
    0))

(defn topic [a :string i :i64 t :i64] [:option :string]
  (if (valid-entry? a i)
    (cond
      (= i 0)
      (cond
        (= t 0) (option-some-of [:option :string] "governance")
        :else (option-none-of [:option :string]))
      (= i 1)
      (cond
        (= t 0) (option-some-of [:option :string] "governance")
        :else (option-none-of [:option :string]))
      (= i 2)
      (cond
        (= t 0) (option-some-of [:option :string] "governance")
        (= t 1) (option-some-of [:option :string] "corporate-form")
        :else (option-none-of [:option :string]))
      (= i 3)
      (cond
        (= t 0) (option-some-of [:option :string] "governance")
        :else (option-none-of [:option :string]))
      (= i 4)
      (cond
        (= t 0) (option-some-of [:option :string] "governance")
        (= t 1) (option-some-of [:option :string] "corporate-form")
        :else (option-none-of [:option :string]))
      (= i 5)
      (cond
        (= t 0) (option-some-of [:option :string] "membership")
        :else (option-none-of [:option :string]))
      (= i 6)
      (cond
        (= t 0) (option-some-of [:option :string] "membership")
        (= t 1) (option-some-of [:option :string] "finance")
        :else (option-none-of [:option :string]))
      (= i 7)
      (cond
        (= t 0) (option-some-of [:option :string] "governance")
        (= t 1) (option-some-of [:option :string] "statute")
        :else (option-none-of [:option :string]))
      (= i 8)
      (cond
        (= t 0) (option-some-of [:option :string] "statute")
        :else (option-none-of [:option :string]))
      (= i 9)
      (cond
        (= t 0) (option-some-of [:option :string] "governance")
        (= t 1) (option-some-of [:option :string] "statute")
        :else (option-none-of [:option :string]))
      (= i 10)
      (cond
        (= t 0) (option-some-of [:option :string] "governance")
        (= t 1) (option-some-of [:option :string] "statute")
        :else (option-none-of [:option :string]))
      (= i 11)
      (cond
        (= t 0) (option-some-of [:option :string] "governance")
        (= t 1) (option-some-of [:option :string] "statute")
        :else (option-none-of [:option :string]))
      (= i 12)
      (cond
        (= t 0) (option-some-of [:option :string] "governance")
        (= t 1) (option-some-of [:option :string] "statute")
        :else (option-none-of [:option :string]))
      :else (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn by-topic-count [a :string candidate :string] :i64
  (if (association-covered? a)
    (cond
      (string=? candidate "governance") 10
      (string=? candidate "corporate-form") 2
      (string=? candidate "membership") 2
      (string=? candidate "finance") 1
      (string=? candidate "statute") 6
      :else 0)
    0))

(defn by-topic-id [a :string candidate :string i :i64] [:option :string]
  (if (association-covered? a)
    (if (= i 0)
      (cond
        (string=? candidate "governance") (entry-field a 0 "id")
        (string=? candidate "corporate-form") (entry-field a 2 "id")
        (string=? candidate "membership") (entry-field a 5 "id")
        (string=? candidate "finance") (entry-field a 6 "id")
        (string=? candidate "statute") (entry-field a 7 "id")
        :else (option-none-of [:option :string]))
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))

(defn coverage-note [a :string] [:option :string]
  (if (association-covered? a)
    (option-some-of [:option :string]
      "cloud-itonami-assoc-9411-fra-medef Wave 0 (ADR-2607141700): 13 medef entries seeded with an official citation. Extend the sovereign catalog; never fabricate a rule id/url.")
    (option-none-of [:option :string])))

(defn main [] :i64 0)
